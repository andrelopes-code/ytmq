Screen {
    background: $ink;
}

#topbar {
    height: 1;
    padding: 0 2;
    margin-top: 1;
}
#brand {
    width: auto;
    text-style: bold;
    color: $accent;
}
#location {
    width: 1fr;
    text-align: right;
}

#searchbar {
    height: 3;
    margin: 1 1 0 1;
    padding: 0 1;
    border: round $raised;
    background: $ink;
}
#searchbar:focus-within {
    border: round $muted;
}
#prompt {
    width: 3;
    color: $muted;
}
#searchbar:focus-within #prompt {
    color: $accent;
}
#search {
    width: 1fr;
    height: 1;
    padding: 0;
    border: none;
    background: transparent;
}
#search > .input--placeholder {
    color: $faint;
}
#search > .input--cursor {
    background: $accent;
    color: $ink;
}

#body {
    height: 1fr;
    margin: 1 1 0 1;
}
#left {
    width: 2fr;
}
#side {
    width: 1fr;
    min-width: 34;
    margin-left: 2;
}
.heading {
    height: 1;
    padding: 0 1;
    margin-bottom: 1;
}
#message {
    height: 1fr;
    content-align: center middle;
    text-align: center;
}

DataTable {
    height: 1fr;
    background: transparent;
    scrollbar-size-vertical: 1;
    scrollbar-background: $ink;
    scrollbar-color: $raised;
    scrollbar-color-hover: $faint;
    scrollbar-color-active: $accent;
}
DataTable > .datatable--cursor {
    background: $raised;
    text-style: none;
}
DataTable:blur > .datatable--cursor {
    background: $surface;
}
DataTable > .datatable--hover {
    background: $surface;
}

#hints {
    height: 1;
    margin: 1 1 0 1;
}

Toast {
    background: $surface;
    border-left: outer $accent;
}

OutputDialog {
    align: center middle;
    background: $ink 70%;
}
OutputDialog > Vertical {
    width: 72;
    max-width: 90%;
    height: auto;
    padding: 1 2;
    border: round $accent;
    border-title-color: $foreground;
    border-title-style: bold;
    background: $surface;
}
OutputDialog Input {
    margin-bottom: 1;
    padding: 0 1;
    border: none;
    background: $raised;
}
OutputDialog .hint {
    color: $muted;
}
